# Скопируйте этот файл в keystore.properties (он в .gitignore, не коммитьте его)
# и впишите свои значения. Путь лучше абсолютный, в Windows — с прямыми слэшами (C:/...).
# Относительный путь считается от папки android/.
storeFile=C:/keys/plastinka-release.jks
storePassword=CHANGE_ME
keyAlias=plastinka
keyPassword=CHANGE_ME
